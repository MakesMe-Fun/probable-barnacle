# 이 파일을 .env로 복사한 뒤 값을 채워주세요.
#   Windows:  copy .env.example .env
#
# .env는 .gitignore로 막혀 있어 깃허브에 올라가지 않습니다.
# GitHub Actions로 돌릴 때는 저장소 Settings > Secrets and variables > Actions 에
# 같은 이름으로 등록하면 워크플로가 알아서 주입합니다.

# LLM 키는 아래 둘 중 하나만 있으면 됩니다. 둘 다 있으면 Gemini를 씁니다.

# 권장: https://aistudio.google.com/apikey 에서 발급 (카드 등록 불필요)
# 무료 한도가 '요청 수' 기준이라, 이슈를 많이 볼수록 유리합니다.
GEMINI_API_KEY=

# 선택: 모델 지정. 비워두면 아래 4개를 순서대로 순환합니다.
#   gemini-3.6-flash -> gemini-3.5-flash -> gemini-3.5-flash-lite -> gemini-3.1-flash-lite
# 무료 티어는 '모델당' 하루 20회라, 한 모델이 소진되면 다음으로 넘어갑니다.
GEMINI_MODEL=

# 선택: 분당 요청 제한을 직접 지정 (비워두면 모델별 기본값)
GEMINI_RPM=

# 대체: https://console.groq.com 에서 발급
# 무료 한도가 '하루 토큰 10만' 기준이라 이슈를 많이 볼수록 빨리 소진됩니다.
GROQ_API_KEY=

# 선택: Discord 채널 설정 > 연동 > 웹후크 만들기 에서 발급
# 설정하지 않으면 Discord 전송 단계는 자동으로 건너뜁니다.
DISCORD_WEBHOOK_URL=
